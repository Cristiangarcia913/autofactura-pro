# Copia este archivo como ".env" y rellena los valores.

# Clave de API de Anthropic (https://console.anthropic.com). Es de pago por uso
# y es independiente de la suscripción de claude.ai.
ANTHROPIC_API_KEY=

# Modelo que lee las facturas
CLAUDE_MODEL=claude-sonnet-5-5

# TU NIF/CIF (sin espacios ni guiones). Sirve para distinguir gastos de ingresos:
# si el emisor de la factura eres tú, es un Ingreso; si no, es un Gasto.
USER_NIF=

# Servidor. HOST=127.0.0.1 => solo accesible desde tu propio ordenador (recomendado:
# la app no tiene login y maneja datos fiscales).
PORT=3000
HOST=127.0.0.1

# 1 = no llama a la IA y rellena datos de ejemplo (para probar la interfaz sin clave)
MOCK_AI=0
